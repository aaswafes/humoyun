# =========================================================
# Public build-time configuration. COMMITTED ON PURPOSE.
#
# Both values below are already inside the JavaScript every visitor downloads —
# Next.js inlines NEXT_PUBLIC_* at build time, so there is nothing here that a
# browser cannot read anyway. Supabase calls the second one a *publishable* key
# for exactly that reason; row-level security is what protects the data, not
# the secrecy of this string.
#
# They live here because a production build cannot start without them. The
# Supabase client is constructed at module scope in `src/lib/store.ts`, so when
# these are missing the build dies while prerendering, and the whole site goes
# down — which is precisely what happened when they went absent from Vercel.
#
# A real environment variable still wins: Next.js will not overwrite anything
# already present in `process.env`, so setting either of these in the Vercel
# dashboard overrides the value here. This is the floor, not the ceiling.
#
# NOTHING SECRET GOES IN THIS FILE. SUPABASE_SERVICE_ROLE_KEY and the Telegram
# tokens have no NEXT_PUBLIC_ prefix, are never inlined, and belong only in
# `.env.local` and the Vercel dashboard.
# =========================================================

NEXT_PUBLIC_SUPABASE_URL=https://ahnugerdawcnerfvtjfo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_O0WGSbjpj5rzGHwdatMexQ_vldAw1O1
